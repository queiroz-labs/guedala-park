    "common_translation_for_two_mirrored_keyholes_exists": false,
    "proposed_method": "Gabinete sustentado e nivelado por apoio temporario;fixacoes inseridas/apertadas por dentro na posicao de trabalho. Nao pendurar os dois rasgos espelhados por uma translacao unica.",
    "method_confirmed_by_manufacturer": false,
    "shank_head_washer": "Validar passagem no rasgo5,assento/retencao da cabeca e montagem no fundo18.Sem diametro,parafuso ou bucha selecionados.",
    "removal": "Suportar gabinete e retirar fixadores pela frente;nao presumir retirada conjunta pelos rasgos.",
    "lower_support": "Compressao inferiorZ90 e partilha continuam hipoteticas;sem pad/retencao inferior dimensionados."
  },
  "source_reading_correction": "Entradau32 nao e assento do rasgo:u40.5=49.5-9. Pequeno furo:u9.5=32-22.5=1.5+8;8 e medido apos a aba,nao da borda externa do fundo.",
  "local_demand_limits": "Momentos r x F sao reducao da mesma forca da parede ao canto(u0/W,v18,zH-58),nao momentos extras somados ao equilibrio global nem solicitacoes isoladas do parafuso. Contatos/parafusosMDF precisam realizar essa resultante;V/3 arbitrario nao equilibra o momento.",
  "qualification_requirements": [
    {
      "item": "Metodo",
      "requirement": "Confirmar orientacao de dois planos verticais,passagem pelo fundo18 e montagem com gabinete sustentado,sem encaixe simultaneo espelhado."
    },
    {
      "item": "FixadoresMDF",
      "requirement": "Definir parafusos,pilotos,profundidade e torque por chapa/substrato reais. Diametros5 na ferragem nao sao pilotos5 no MDF;validar passo12 e borda9.5."
    },
    {
      "item": "Cabeca e rasgo",
      "requirement": "Desenho do assento/cabeca/arruela no rasgo5 e entrada10,largura16 da tira e retencao contra abertura/deslocamento;sem recomendar diametro de ancoragem."
    },
    {
      "item": "Contatos e momentos",
      "requirement": "Demonstrar reparticao com apoio no fundo18 e na lateral,flexao/esmagamento,ligacoes e momentos locais r x F. Nao V/3 ou V/2 sem rigidez/caminho."
    },
    {
      "item": "Ensaio de conjunto",
      "requirement": "Montagem representativa com chapaBP18 real e fixadores escolhidos,sem credito a atrito nao controlado. Aplicar V/T simultaneos nos casos identificados;fabricante/RT define coeficientes,duracao,ciclos e limites de deslocamento/creep/ruptura. Sem criterio de aceitacao nao ha aprovacao."
    },
    {
      "item": "Inferior e retirada",
      "requirement": "Detalhar compressao inferior e retencao,apoio temporario e acesso para apertar/retirar;envelope nao inclui capas,cabecas ou ferramenta real."
    },
    {
      "item": "Parede",
      "requirement": "So apos identificar substrato,revestimento e instalacoes definir tipo/profundidade da ancoragem. Nao atribuir a ferragem capacidade da parede."
    }
  ],
