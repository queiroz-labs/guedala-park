{
  "_leia_me": "Fatos do projeto que nao podem se contradizer entre documentos. Mudar um fato exige decisao de Elias: edite este arquivo e os documentos no mesmo commit. Regex em JSON: barra invertida dobrada.",
  "fatos": [
    {
      "id": "verba",
      "descricao": "Verba: R$ 120 mil de execucao + R$ 10 mil de reserva intocada",
      "exigir": [
        {
          "arquivo": "ESTADO_ATUAL.md",
          "regex": "R\\$ ?120 mil"
        },
        {
          "arquivo": "ESTADO_ATUAL.md",
          "regex": "R\\$ ?10 mil"
        }
      ],
      "proibir": [
        {
          "regex": "(?i)\\bverba (?:total|de execu[cç][aã]o|do projeto)[^.|\\n]{0,25}R\\$ ?(?!120|10 ?mil)[0-9]",
          "escopo": [
            "ESTADO_ATUAL.md",
            "README.md",
            "01_Programa_e_decisoes/Programa_de_necessidades.md",
            "05_Orcamento_e_cronograma/Orcamento/Orcamento_R43.md",
